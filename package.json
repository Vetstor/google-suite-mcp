{
  "name": "google-mcp",
  "version": "1.0.0",
  "description": "Google Workspace MCP server (Sheets, Docs, Slides) — remote OAuth (multi-user) + stdio (service account)",
  "type": "module",
  "bin": {
    "sheets-mcp": "dist/stdio.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/remote/index.js",
    "start:stdio": "node dist/stdio.js",
    "dev": "tsx src/remote/index.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "smoke": "tsx src/smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/firestore": "^7.11.6",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.0.0",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "googleapis": "^144.0.0",
    "pino": "^9.14.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
