# =============================================================================
# Remote mode (multi-user OAuth) — src/remote/index.ts, deployed to Cloud Run
# =============================================================================

# Public https URL of this service (no trailing slash). On Cloud Run this is the
# service URL; the Google redirect URI is <BASE_URL>/oauth/google/callback and
# the MCP endpoint is <BASE_URL>/mcp.
BASE_URL=https://sheets-mcp-xxxxxxxxxx-ew.a.run.app

# Google OAuth 2.0 "Web application" client credentials.
GOOGLE_OAUTH_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# 32-byte AES-256 key, base64-encoded. Generate with:  openssl rand -base64 32
# Encrypts each user's Google refresh token at rest. Keep it stable across
# deploys (rotating it invalidates all stored refresh tokens).
TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Comma-separated allowed email domains. If unset, ALL Google accounts are
# accepted (a warning is logged). Recommended for org rollouts.
ALLOWED_DOMAINS=example.com

# Storage backend: firestore (default, uses Application Default Credentials) or
# memory (ephemeral; local dev / tests only).
STORE=firestore

# Firestore database id. Default "(default)".
FIRESTORE_DATABASE=(default)

# Port to listen on. Cloud Run injects this; default 8080.
PORT=8080

# Optional log level (pino): trace|debug|info|warn|error. Default info.
LOG_LEVEL=info

# =============================================================================
# Stdio mode (single service account, headless) — src/stdio.ts
# =============================================================================

# Path to your service account JSON key file...
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/path/to/service-account.json

# ...OR the raw JSON string (or base64-encoded JSON).
# GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Optional: impersonate a Workspace user via domain-wide delegation.
# GOOGLE_IMPERSONATE_USER=user@yourdomain.com

# Comma-separated list of tool tiers to expose. Valid values: read, write, destructive.
# Defaults to all three when unset.
# TOOL_TIERS=read,write,destructive
